---
import Layout from '../layouts/Layout.astro';

// ---------------------------------------------------------------------------
// STORE LINKS — switch the badges on by filling these in.
// Both listings are in review; until a URL exists the buttons render as a
// "coming soon" note instead, because a badge that 404s is worse than none.
// Set the two strings below and the buttons appear. Nothing else to change.
// ---------------------------------------------------------------------------
const STORE_LINKS = {
	appStore: '', // e.g. 'https://apps.apple.com/app/weatherie/id0000000000'
	googlePlay: '', // e.g. 'https://play.google.com/store/apps/details?id=com.advection.weatherie'
};
const hasAppStore = STORE_LINKS.appStore.trim() !== '';
const hasGooglePlay = STORE_LINKS.googlePlay.trim() !== '';
const hasAnyStoreLink = hasAppStore || hasGooglePlay;

// Promo video (public, Advection Software LLC channel).
const PROMO_VIDEO_ID = 'E9zXkWXMWjU';

const openWeatherApiKey = (
	import.meta.env.OPENWEATHERMAP_API_KEY ??
	import.meta.env.PUBLIC_OPENWEATHERMAP_API_KEY ??
	''
).trim();

const buildDemoSrc = (params = {}) => {
	const url = new URL('https://weatherie.local/demo/index.html');
	for (const [key, value] of Object.entries(params)) {
		if (value != null && String(value).trim() !== '') {
			url.searchParams.set(key, String(value));
		}
	}
	if (openWeatherApiKey) {
		url.searchParams.set('owmKey', openWeatherApiKey);
	}
	return `${url.pathname}${url.search}`;
};

const fullDemoSrc = buildDemoSrc();
const hourlyDemoSrc = buildDemoSrc({
	scene: 'hourly',
	renderer: 'canvaskit',
	v: '20261014a',
});

// ---------------------------------------------------------------------------
// Theme catalogue — the 11 themes live in /v1/catalog on 2026-10-14, with the
// display names and descriptions the app itself shows. Drafts are excluded.
// Stills are the press kit's, reused in place so the page adds no new bytes.
// ---------------------------------------------------------------------------
const bundledTheme = {
	name: 'Open Road',
	desc: 'Travel-poster landscapes — canyons, coasts, prairies and peaks — ninety places painted in every kind of weather.',
	img: '/media/theme-open-road.jpg',
};

const themes = [
	{ id: 'artdeco', name: 'Streamline', tier: 'free', desc: 'Travel-poster glamour from the thirties: bold geometry, chrome curves and flat saturated colour.' },
	{ id: 'lowpoly', name: 'Facets', tier: 'free', desc: 'Wild country rebuilt from flat triangles: glaciers, canyons, fjords and dune seas.' },
	{ id: 'papercraft', name: 'Papercraft', tier: 'free', desc: 'Landscapes cut and layered from coloured paper — bevelled edges, folded hills, soft shadows between every plane.' },
	{ id: 'van-gogh', name: 'Impasto Fields', tier: 'paid', desc: 'Thick oil paint and swirling skies over low, quiet horizons.' },
	{ id: 'stainedglass2', name: 'Leaded Light', tier: 'paid', desc: 'Stained glass lit from behind: pastoral days, lantern-lit nights, every pane hand-leaded.' },
	{ id: 'artnouveau', name: 'Belle Époque', tier: 'paid', desc: 'Art nouveau panels — one figure, one craft, and flowering ornament running through every frame.' },
	{ id: 'tinbot', name: 'Tin Traveller', tier: 'paid', desc: 'A small brass automaton alone in vast weather, with one amber lamp for company.' },
	{ id: 'fox', name: 'Little Fox', tier: 'paid', desc: 'A small fox in a blue scarf, out in every weather there is.' },
	{ id: 'creaturephoto', name: 'Eye Level', tier: 'paid', desc: 'Photographed lying in the grass — a wren, a stag beetle, a sand cat — with the weather at their scale.' },
	{ id: 'paperminimal', name: 'Folded', tier: 'paid', desc: 'A different origami creature every time, folded from coloured paper under soft studio light.' },
	{ id: 'balloonfolk', name: 'Balloon Animals', tier: 'paid', desc: 'Everything twisted from modelling balloons — the animals, the clouds, even the rain.' },
].map((t) => ({ ...t, img: `/press/media/themes/${t.id}.jpg` }));

const freeThemeCount = themes.filter((t) => t.tier === 'free').length;

const shots = [
	{ src: '/media/shot-01_today_sunny.jpg', alt: 'Weatherie today screen with the built-in Open Road theme' },
	{ src: '/media/shot-02_forecast_cards.jpg', alt: 'Hourly strip and ten-day outlook' },
	{ src: '/media/shot-03_detail_tiles.jpg', alt: 'Wind, UV, humidity, sunrise and sunset detail tiles' },
	{ src: '/media/shot-04_theme_store.jpg', alt: 'The Weatherie theme store' },
];
---

<Layout
	title="Weatherie — Thousands of ways to see the weather"
	description="A weather app you'll want to look at. Every theme is a complete set of artwork — a scene for each kind of weather, day and night. Credits, not subscriptions."
>
	<!-- Decorative Background Elements -->
	<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
		<div class="absolute -top-[10%] -left-[10%] h-[40%] w-[40%] rounded-full bg-sky-500/14 blur-[140px]"></div>
		<div class="absolute top-[20%] -right-[10%] h-[50%] w-[30%] rounded-full bg-teal-400/12 blur-[120px]"></div>
		<div class="absolute -bottom-[10%] left-[20%] h-[40%] w-[50%] rounded-full bg-violet-500/10 blur-[140px]"></div>
	</div>

	<main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Floating Navigation -->
		<nav class="sticky top-0 z-50 mt-6 flex items-center justify-between rounded-2xl border border-white/10 bg-slate-950/65 px-6 py-4 shadow-[0_20px_60px_-35px_rgba(15,23,42,0.9)] backdrop-blur-xl">
			<div class="flex items-center gap-3">
				<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-sky-400 to-teal-400 text-xl font-black text-white shadow-inner shadow-cyan-950/40">
					W
				</div>
				<span class="font-['Outfit'] text-xl font-extrabold uppercase tracking-tight text-slate-100">Weatherie</span>
			</div>
			<div class="hidden gap-10 text-sm font-bold uppercase tracking-widest text-slate-400 md:flex">
				<a href="#preview" class="transition-colors hover:text-sky-300">Preview</a>
				<a href="#themes" class="transition-colors hover:text-sky-300">Themes</a>
				<a href="#features" class="transition-colors hover:text-sky-300">Features</a>
				<a href="#pricing" class="transition-colors hover:text-sky-300">Pricing</a>
			</div>
			<a href="#download" class="rounded-xl border border-sky-300/10 bg-sky-400 px-5 py-2 text-sm font-bold text-slate-950 shadow-lg shadow-sky-950/40 transition-all hover:bg-sky-300 active:scale-95">
				Get App
			</a>
		</nav>

		<!-- Immersive Hero -->
		<header class="py-12 md:py-20 text-center space-y-12">
			<div class="space-y-6 max-w-4xl mx-auto">
				<div class="mb-4 inline-block rounded-full border border-sky-300/15 bg-sky-400/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-sky-200">
					Enjoy the weather you choose
				</div>
				<h1 class="font-['Outfit'] text-5xl font-black leading-[0.95] tracking-tight text-slate-50 md:text-8xl md:leading-[0.9]">
					Thousands of ways<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-500 via-teal-500 to-violet-500">to see the weather.</span>
				</h1>
				<p class="mx-auto max-w-2xl text-xl font-medium leading-relaxed text-slate-300">
					Every theme is a complete set of artwork — a scene for each kind of weather, day and night. So the forecast you open each morning is a picture of the day ahead.
				</p>
			</div>

			<div id="preview" class="relative max-w-4xl mx-auto scroll-mt-28">
				<div class="flex justify-center pb-3">
					<div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-slate-950/70 px-4 py-2 text-[11px] font-black uppercase tracking-[0.28em] text-slate-300 shadow-sm backdrop-blur">
						<span class="block h-2 w-2 rounded-full bg-sky-400"></span>
						Live in your browser
					</div>
				</div>
				<!-- Mockup Group -->
				<div class="relative z-10 flex justify-center items-end gap-4 md:gap-8">
					<div class="hidden h-[400px] w-48 -rotate-12 translate-y-12 overflow-hidden rounded-[2.5rem] border border-white/6 bg-slate-950 shadow-2xl opacity-40 md:block">
						<img src="/press/media/themes/van-gogh.jpg" alt="" aria-hidden="true" loading="lazy" class="h-full w-full object-cover" />
					</div>
					<div class="relative group" data-demo-phone-shell>
						<!-- High-end Glow -->
						<div class="absolute -inset-4 bg-gradient-to-r from-sky-500/20 to-violet-500/20 rounded-[4rem] blur-3xl opacity-50 group-hover:opacity-80 transition-opacity duration-700"></div>

						<!-- Realistic Phone Frame -->
						<div class="relative bg-[#1a1a1a] p-[10px] rounded-[3.5rem] shadow-[0_50px_100px_-20px_rgba(0,0,0,0.5)] border-[1px] border-white/10 ring-1 ring-black ring-inset">
							<!-- Side Buttons -->
							<div class="absolute -left-[2px] top-24 w-[3px] h-12 bg-[#222] rounded-r-sm border-l border-white/5"></div>
							<div class="absolute -left-[2px] top-40 w-[3px] h-12 bg-[#222] rounded-r-sm border-l border-white/5"></div>
							<div class="absolute -right-[2px] top-32 w-[3px] h-20 bg-[#222] rounded-l-sm border-r border-white/5"></div>

							<!-- Inner Bezel -->
							<div class="w-[280px] md:w-[310px] aspect-[9/19.5] bg-black rounded-[2.8rem] overflow-hidden relative shadow-inner ring-1 ring-white/5">

								<!-- Dynamic Island -->
								<div class="absolute top-2.5 left-1/2 -translate-x-1/2 w-24 h-6 bg-black rounded-full z-20 flex items-center justify-end px-3 gap-1.5">
									<div class="w-1 h-1 bg-sky-500/40 rounded-full"></div>
									<div class="w-2 h-2 bg-[#111] rounded-full ring-1 ring-white/5"></div>
								</div>

								<!-- Screen Content -->
								<div class="w-full h-full relative z-10 overflow-hidden" style="overscroll-behavior: contain;">
									<div class="absolute inset-0 overflow-hidden">
										<div class="w-[125%] h-[125%] origin-top-left scale-[0.8]" style="overscroll-behavior: contain;">
											<iframe src={fullDemoSrc} data-demo-frame data-demo-phone-frame data-base-src={fullDemoSrc} class="block w-full h-full border-none" style="overscroll-behavior: contain;" allow="geolocation" scrolling="no" title="Weatherie Interactive Demo"></iframe>
										</div>
									</div>
								</div>

								<!-- Screen Reflection -->
								<div class="absolute inset-0 pointer-events-none z-30 bg-gradient-to-tr from-transparent via-white/[0.02] to-white/[0.05]"></div>
							</div>
						</div>
					</div>
					<div class="hidden h-[400px] w-48 translate-y-12 rotate-12 overflow-hidden rounded-[2.5rem] border border-white/6 bg-slate-950 shadow-2xl opacity-40 md:block">
						<img src="/press/media/themes/stainedglass2.jpg" alt="" aria-hidden="true" loading="lazy" class="h-full w-full object-cover" />
					</div>
				</div>
				<p class="relative z-20 mt-8 text-sm font-medium text-slate-400">
					That's the real app, running here in your browser. Scroll it, tap it — no install, no sign-up.
				</p>
			</div>
		</header>

		<!-- Promo video -->
		<section id="video" class="py-12 scroll-mt-28">
			<div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)]">
				<div class="space-y-5 text-center lg:text-left">
					<div class="text-[10px] font-black uppercase tracking-[0.24em] text-sky-300/70">Twenty-eight seconds</div>
					<h2 class="font-['Outfit'] text-4xl font-black uppercase tracking-tight text-slate-50 md:text-5xl">
						See it move
					</h2>
					<p class="mx-auto max-w-lg text-lg font-medium leading-relaxed text-slate-300 lg:mx-0">
						A quick tour of the themes, the forecast and the widgets. The artwork does most of the talking.
					</p>
					<p class="text-sm font-medium text-slate-500">
						Nothing loads from YouTube until you press play.
					</p>
				</div>
				<div class="mx-auto w-full max-w-[320px]">
					<div
						class="relative aspect-[9/16] overflow-hidden rounded-[2.5rem] border border-white/10 bg-slate-950 shadow-[0_40px_120px_-40px_rgba(15,23,42,0.9)]"
						data-video-facade
						data-video-id={PROMO_VIDEO_ID}
					>
						<img
							src="/media/promo-poster.jpg"
							alt="Weatherie promo video"
							loading="lazy"
							class="absolute inset-0 h-full w-full object-cover"
						/>
						<button
							type="button"
							data-video-play
							aria-label="Play the Weatherie promo video"
							class="group absolute inset-0 flex items-center justify-center bg-gradient-to-t from-slate-950/55 via-transparent to-transparent transition-colors hover:bg-slate-950/25"
						>
							<span class="flex h-20 w-20 items-center justify-center rounded-full border border-white/25 bg-slate-950/55 backdrop-blur transition-transform duration-300 group-hover:scale-110">
								<svg class="ml-1 h-8 w-8 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
							</span>
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Theme catalogue -->
		<section class="py-12 overflow-hidden">
			<div id="themes" class="text-center max-w-3xl mx-auto mb-12 px-4 scroll-mt-28">
				<h2 class="mb-4 font-['Outfit'] text-4xl font-black uppercase tracking-tight text-slate-50">Theme Packs</h2>
				<p class="text-lg font-medium text-slate-300">
					One is built in and free. Eleven more are in the store — {freeThemeCount} of those are free too. New themes keep arriving.
				</p>
			</div>

			<!-- Bundled default -->
			<div class="mb-10 overflow-hidden rounded-[3rem] border border-amber-200/12 bg-gradient-to-br from-[#2a1b12] via-[#43291c] to-slate-950">
				<div class="grid items-center gap-8 p-8 md:grid-cols-[minmax(0,0.42fr)_minmax(0,1fr)] md:p-10">
					<img
						src={bundledTheme.img}
						alt="Open Road, the theme built into Weatherie"
						loading="lazy"
						class="mx-auto w-full max-w-[220px] rounded-[2rem] border border-white/10 object-cover shadow-2xl"
					/>
					<div class="space-y-4 text-center md:text-left">
						<div class="inline-flex items-center gap-2 rounded-full border border-amber-200/20 bg-amber-100/10 px-4 py-1.5 text-[10px] font-black uppercase tracking-[0.24em] text-amber-100">
							Built in · Free with the app
						</div>
						<h3 class="font-['Outfit'] text-3xl font-black text-white md:text-4xl">{bundledTheme.name}</h3>
						<p class="mx-auto max-w-xl font-medium leading-relaxed text-orange-50/80 md:mx-0">{bundledTheme.desc}</p>
						<p class="text-sm font-bold uppercase tracking-[0.18em] text-amber-100/50">No account, no purchase, nothing to unlock.</p>
					</div>
				</div>
			</div>

			<div class="relative">
				<div id="carousel" class="flex overflow-x-auto pb-12 hide-scrollbar snap-x snap-mandatory gap-6 px-4 md:px-[calc(50%-150px)]">
					{
						themes.map((item) => (
							<div class="carousel-item min-w-[260px] md:min-w-[300px] snap-center transition-all duration-500 will-change-transform">
								<div class="flex h-full flex-col overflow-hidden rounded-[2.5rem] border border-white/10 bg-slate-900/80 shadow-xl">
									<div class="relative aspect-[416/746] overflow-hidden">
										<img src={item.img} alt={`${item.name} theme`} loading="lazy" class="h-full w-full object-cover" />
										<span
											class={`absolute right-4 top-4 rounded-full px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.18em] backdrop-blur ${
												item.tier === 'free'
													? 'bg-teal-400/90 text-slate-950'
													: 'bg-slate-950/75 text-amber-200 ring-1 ring-amber-200/30'
											}`}
										>
											{item.tier === 'free' ? 'Free' : '2 Credits'}
										</span>
									</div>
									<div class="flex flex-1 flex-col p-6">
										<h3 class="mb-2 font-['Outfit'] text-xl font-black text-slate-50">{item.name}</h3>
										<p class="text-sm font-medium leading-relaxed text-slate-400">{item.desc}</p>
									</div>
								</div>
							</div>
						))
					}
				</div>

				<div class="pointer-events-none mt-2 flex justify-center gap-4 text-slate-500">
					<svg class="w-6 h-6 animate-bounce-x-left" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
					<span class="text-xs font-black uppercase tracking-[0.3em]">Swipe Themes</span>
					<svg class="w-6 h-6 animate-bounce-x-right" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
				</div>
			</div>
		</section>

		<!-- Screenshots -->
		<section class="py-12">
			<div class="mx-auto mb-12 max-w-3xl px-4 text-center">
				<h2 class="mb-4 font-['Outfit'] text-4xl font-black uppercase tracking-tight text-slate-50">In the app</h2>
				<p class="text-lg font-medium text-slate-300">Everything you came for, under the artwork.</p>
			</div>
			<div class="grid grid-cols-2 gap-5 lg:grid-cols-4">
				{
					shots.map((shot) => (
						<img
							src={shot.src}
							alt={shot.alt}
							loading="lazy"
							class="w-full rounded-[1.75rem] border border-white/10 shadow-[0_30px_80px_-40px_rgba(8,15,29,1)]"
						/>
					))
				}
			</div>
		</section>

		<!-- Features -->
		<section id="features" class="py-12 scroll-mt-28">
			<div class="mx-auto mb-12 max-w-3xl space-y-4 px-4 text-center">
				<h2 class="font-['Outfit'] text-4xl font-black uppercase tracking-tight text-slate-50 md:text-6xl">
					Features
				</h2>
				<p class="text-lg font-medium leading-relaxed text-slate-300">
					A closer look at the forecast, the widgets and the theme system.
				</p>
			</div>

			<div class="grid grid-cols-1 gap-6 md:grid-cols-4 md:auto-rows-[minmax(14rem,auto)]">
				<div class="relative overflow-hidden rounded-[3rem] border border-white/10 bg-slate-950 p-6 text-white shadow-[0_40px_120px_-40px_rgba(15,23,42,0.55)] md:col-span-4 md:p-8">
					<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.26),_transparent_34%),radial-gradient(circle_at_bottom_right,_rgba(20,184,166,0.2),_transparent_36%),linear-gradient(135deg,_rgba(15,23,42,0.98),_rgba(2,6,23,0.92))]"></div>
					<div class="relative z-10 grid gap-6 lg:grid-cols-[minmax(18rem,0.78fr)_minmax(0,1fr)] lg:items-start">
						<div class="space-y-5 text-left lg:py-4">
							<div class="space-y-4">
								<div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[10px] font-black uppercase tracking-[0.24em] text-white/60">
									<span class="block h-2 w-2 rounded-full bg-sky-400"></span>
									Live Widget
								</div>
								<h3 class="text-3xl font-black leading-[0.95] text-white md:text-5xl font-['Outfit'] uppercase tracking-tight">
									Hourly Forecast
								</h3>
								<p class="max-w-lg text-base leading-relaxed text-slate-300 md:text-lg">
									Turn rows on or off, scroll through the next hours, and keep the layout you actually use. This one is live — try it.
								</p>
							</div>
							<div class="grid gap-3 sm:grid-cols-2">
								<div class="rounded-[1.6rem] border border-white/10 bg-white/5 p-4">
									<div class="text-[10px] font-black uppercase tracking-[0.24em] text-white/45">Toggles</div>
									<div class="mt-2 text-lg font-black text-white font-['Outfit']">Show what matters</div>
									<p class="mt-2 text-sm leading-relaxed text-slate-300">Pick the rows you want to keep in view.</p>
								</div>
								<div class="rounded-[1.6rem] border border-white/10 bg-white/5 p-4">
									<div class="text-[10px] font-black uppercase tracking-[0.24em] text-white/45">Memory</div>
									<div class="mt-2 text-lg font-black text-white font-['Outfit']">Keeps your picks</div>
									<p class="mt-2 text-sm leading-relaxed text-slate-300">Your row choices stay in place for the next visit.</p>
								</div>
								<div class="rounded-[1.6rem] border border-white/10 bg-white/5 p-4 sm:col-span-2">
									<div class="text-[10px] font-black uppercase tracking-[0.24em] text-white/45">Icon Guide</div>
									<div class="mt-3 grid grid-cols-2 gap-2">
										<div class="flex items-center gap-3 rounded-xl bg-black/15 px-3 py-2 text-sm font-black text-white">
											<svg class="h-4 w-4 text-sky-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M8 3H3v5M16 3h5v5M8 21H3v-5M21 16v5h-5" />
												<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l5-5M16 3l5 5M3 16l5 5M21 16l-5 5" />
											</svg>
											<span>Expand all</span>
										</div>
										<div class="flex items-center gap-3 rounded-xl bg-black/15 px-3 py-2 text-sm font-black text-white">
											<svg class="h-4 w-4 text-sky-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12M8 12h8M10 17h4" />
											</svg>
											<span>Collapse all</span>
										</div>
										<div class="flex items-center gap-3 rounded-xl bg-black/15 px-3 py-2 text-sm font-black text-white">
											<svg class="h-4 w-4 text-sky-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M14 14.76V5a2 2 0 1 0-4 0v9.76a4 4 0 1 0 4 0Z" />
											</svg>
											<span>Temperature</span>
										</div>
										<div class="flex items-center gap-3 rounded-xl bg-black/15 px-3 py-2 text-sm font-black text-white">
											<svg class="h-4 w-4 text-sky-200" viewBox="0 0 24 24" fill="currentColor">
												<path d="M12 2.5C9.6 6 6 9.6 6 13.5a6 6 0 1 0 12 0c0-3.9-3.6-7.5-6-11Z" />
											</svg>
											<span>Precipitation</span>
										</div>
										<div class="flex items-center gap-3 rounded-xl bg-black/15 px-3 py-2 text-sm font-black text-white">
